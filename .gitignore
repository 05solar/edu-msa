# 의존성 / 빌드 산출물
node_modules/
dist/
dist-ssr/
build/
.gradle/
out/
bin/

# 로컬/에디터/OS
*.local
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.log

# 환경 파일
.env
.env.*
!.env.example

# 평문 Secret 파일은 커밋 금지 — 봉인본(*.sealed.yaml)만 허용 (deploy/k8s/secrets/README.md)
deploy/k8s/secrets/*.yaml
!deploy/k8s/secrets/*.sealed.yaml

# 부하 테스트 원시 산출물(csv/json/log)은 커밋하지 않는다 — 판독 문서(RESULTS-*.md)만 커밋
loadtest/results/

# 시각 문서(HTML)는 로컬에만 두고 원격에 올리지 않는다
html/*.html
deploy/infra-overview.html
