# docker compose 용 환경변수 예시.
# 이 파일을 .env 로 복사한 뒤 값을 바꿔서 사용한다. (.env 는 커밋하지 않는다)

# auth-service 가 JWT 를 발급하고 backend 가 검증할 때 쓰는 공용 서명 키.
# HS256 이므로 32바이트(영문 기준 32자) 이상이어야 한다.
EDU_JWT_SECRET=change-me-edu-msa-local-development-secret-key

# 데모 계정 7명의 공통 임시 비밀번호 (최초 기동 시 BCrypt 해시로 저장된다)
EDU_SEED_PASSWORD=Edu@2026!

# DB 비밀번호 (미설정 시 개발용 기본값 사용)
DB_PASSWORD=edumsa
AUTH_DB_PASSWORD=eduauth
