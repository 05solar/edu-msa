# 필수 Secret 의 "형태" 문서 — 직접 apply 하지 않는다(.template 확장자라 kubectl 대상 아님).
# 값을 채운 뒤 반드시 kubeseal 로 봉인해 *.sealed.yaml 만 커밋/적용한다. (README.md 참조)
# REPLACE_WITH_* 를 남긴 채 적용되는 일이 없도록 실제 파일은 .gitignore 로 차단된다.
apiVersion: v1
kind: Secret
metadata:
  name: edu-db
  namespace: edu-platform
type: Opaque
stringData:
  MARIADB_DATABASE: edumsa
  MARIADB_USER: edumsa
  MARIADB_PASSWORD: REPLACE_WITH_RANDOM_24B
  MARIADB_ROOT_PASSWORD: REPLACE_WITH_RANDOM_24B
---
apiVersion: v1
kind: Secret
metadata:
  name: edu-auth-db
  namespace: edu-platform
type: Opaque
stringData:
  MARIADB_DATABASE: eduauth
  MARIADB_USER: eduauth
  MARIADB_PASSWORD: REPLACE_WITH_RANDOM_24B
  MARIADB_ROOT_PASSWORD: REPLACE_WITH_RANDOM_24B
---
# Gitea 외부 DB(플랫폼 MariaDB 의 gitea 데이터베이스) 계정 비밀번호.
# MariaDB 최초 초기화 시 init 스크립트가 이 값으로 gitea 계정을 만들고,
# bootstrap 이 Gitea 차트의 database.PASSWD 로 주입한다.
apiVersion: v1
kind: Secret
metadata:
  name: edu-gitea-db
  namespace: edu-platform
type: Opaque
stringData:
  password: REPLACE_WITH_RANDOM_24B
---
apiVersion: v1
kind: Secret
metadata:
  name: edu-auth-jwt
  namespace: edu-platform
type: Opaque
stringData:
  EDU_JWT_SECRET: REPLACE_WITH_RANDOM_48B_MIN_32B
  EDU_SEED_PASSWORD: REPLACE_WITH_RANDOM_12B
---
apiVersion: v1
kind: Secret
metadata:
  name: edu-redis-auth
  namespace: edu-platform
type: Opaque
stringData:
  password: REPLACE_WITH_RANDOM_24B
---
apiVersion: v1
kind: Secret
metadata:
  name: edu-db-backup-creds
  namespace: edu-platform
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_WITH_OBJECT_STORAGE_KEY
  ACCESS_SECRET_KEY: REPLACE_WITH_OBJECT_STORAGE_SECRET
