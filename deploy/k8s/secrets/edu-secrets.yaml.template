# 필수 Secret 의 "형태" 문서 — 직접 apply 하지 않는다(.template 확장자라 kubectl 대상 아님).
# 값을 채운 뒤 반드시 kubeseal 로 봉인해 *.sealed.yaml 만 커밋/적용한다. (README.md 참조)
# REPLACE_WITH_* 를 남긴 채 적용되는 일이 없도록 실제 파일은 .gitignore 로 차단된다.
apiVersion: v1
kind: Secret
metadata:
  name: edu-db
  namespace: edu-platform
type: Opaque
stringData:
  POSTGRES_DB: edumsa
  POSTGRES_USER: edumsa
  POSTGRES_PASSWORD: REPLACE_WITH_RANDOM_24B
---
apiVersion: v1
kind: Secret
metadata:
  name: edu-auth-db
  namespace: edu-platform
type: Opaque
stringData:
  POSTGRES_DB: eduauth
  POSTGRES_USER: eduauth
  POSTGRES_PASSWORD: REPLACE_WITH_RANDOM_24B
---
apiVersion: v1
kind: Secret
metadata:
  name: edu-auth-jwt
  namespace: edu-platform
type: Opaque
stringData:
  EDU_JWT_SECRET: REPLACE_WITH_RANDOM_48B_MIN_32B
  EDU_SEED_PASSWORD: REPLACE_WITH_RANDOM_12B
---
apiVersion: v1
kind: Secret
metadata:
  name: edu-redis-auth
  namespace: edu-platform
type: Opaque
stringData:
  password: REPLACE_WITH_RANDOM_24B
---
apiVersion: v1
kind: Secret
metadata:
  name: edu-db-backup-creds
  namespace: edu-platform
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_WITH_OBJECT_STORAGE_KEY
  ACCESS_SECRET_KEY: REPLACE_WITH_OBJECT_STORAGE_SECRET
